generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanCategory {
  STORAGE
  SYNC
}

/// Peran platform. USER = pelanggan biasa (default untuk semua pendaftar
/// lewat Google). ADMIN/SUPERADMIN hanya dipakai panel admin internal —
/// lihat middleware `requireAdmin`.
enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

/// Peran seseorang di dalam satu toko. Berbeda dari `UserRole` yang mengatur
/// akses panel admin platform. OWNER adalah penanggung langganan: kuota
/// storage, masa aktif SYNC, dan pembayaran selalu dibaca dari dia, bukan
/// dari anggota yang sedang login.
enum ReleasePlatform {
  ANDROID
  WINDOWS
}

enum StoreRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id             String    @id @default(cuid())
  googleSub      String    @unique @map("google_sub")
  email          String
  name           String
  picture        String?
  role           UserRole  @default(USER)
  /// Suspend/soft-delete. Panel admin tidak menyediakan hapus permanen karena
  /// relasi di bawah memakai onDelete: Cascade.
  deletedAt      DateTime? @map("deleted_at")
  planId         String?   @map("plan_id")
  storageLimitMb Int       @default(0) @map("storage_limit_mb")
  syncExpiry     DateTime? @map("sync_expiry")
  maxStores      Int?      @map("max_stores")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  plans               Plan[]
  subscriptions       Subscription[]
  stores              Store[]
  backups             Backup[]
  paymentTransactions PaymentTransaction[]
  syncRecords         SyncRecord[]
  auditLogs           AuditLog[]
  appReleases         AppRelease[]
  memberships         StoreMember[]
  invitesSent         StoreInvite[]
  aiScanUsages        AiScanUsage[]
  voiceCartSessions   VoiceCartSession[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Plan {
  id             String       @id @default(cuid())
  name           String
  category       PlanCategory
  storageLimitMb Int          @map("storage_limit_mb")
  price          Int
  /// Masa aktif paket dalam hari. Sebelumnya 30 hari di-hardcode di
  /// `createOrExtendSubscription`, sehingga paket tahunan pun hanya memberi
  /// 30 hari. Default 30 supaya paket yang sudah ada tidak berubah perilakunya.
  durationDays   Int          @default(30) @map("duration_days")
  maxStores      Int?         @map("max_stores")
  /// Batas jumlah anggota (termasuk owner) per toko. null = tidak dibatasi,
  /// dipakai paket lama yang dibuat sebelum fitur multi-user cloud ada.
  maxMembers     Int?         @map("max_members")
  /// Jatah scan produk dari foto per periode langganan. 0 = fitur mati untuk
  /// paket ini; pengguna tanpa langganan aktif memakai VISION_FREE_QUOTA.
  aiScanQuota    Int          @default(0) @map("ai_scan_quota")
  /// Paket yang diarsipkan hilang dari pilihan tapi riwayatnya utuh. Panel
  /// tidak menyediakan hapus permanen: relasi ke Subscription dan
  /// PaymentTransaction memakai onDelete: Cascade, jadi menghapus satu paket
  /// ikut menghapus catatan uang yang sudah masuk.
  archivedAt     DateTime?    @map("archived_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  users               User[]
  subscriptions       Subscription[]
  paymentTransactions PaymentTransaction[]

  @@map("plans")
}

model Subscription {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  planId                String   @map("plan_id")
  startDate             DateTime @map("start_date")
  endDate               DateTime @map("end_date")
  status                String
  hasActiveSubscription Boolean  @map("has_active_subscription")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([status, endDate])
  @@index([userId])
  @@map("subscriptions")
}

model Store {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  name             String
  identifier       String?  @unique
  isPublic         Boolean  @default(false) @map("is_public")
  address1         String?
  address2         String?
  provinceId       Int?     @map("province_id")
  provinceName     String?  @map("province_name")
  cityId           Int?     @map("city_id")
  cityName         String?  @map("city_name")
  districtId       Int?     @map("district_id")
  districtName     String?  @map("district_name")
  latitude         Float?
  longitude        Float?
  phone            String?
  timezone         String?
  operationalHours Json?    @map("operational_hours")
  logoUrl          String?  @map("logo_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  backups     Backup[]
  syncRecords SyncRecord[]
  members     StoreMember[]
  invites     StoreInvite[]

  @@index([userId])
  @@map("stores")
}

/// Keanggotaan seseorang di sebuah toko. `Store.userId` tetap dipertahankan
/// sebagai penanda pemilik/penanggung langganan; tabel ini hanya menambah
/// lapisan akses di atasnya. Setiap toko selalu punya tepat satu baris OWNER
/// yang mencerminkan `Store.userId`.
model StoreMember {
  id      String    @id @default(cuid())
  storeId String    @map("store_id")
  userId  String    @map("user_id")
  role    StoreRole @default(STAFF)
  /// Permission granular POS, mencerminkan `PermissionKey` di frontend.
  /// null untuk OWNER — owner selalu punya semua izin.
  permissions Json?
  invitedBy   String?   @map("invited_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

/// Undangan yang belum diterima. Dipisah dari StoreMember supaya baris
/// keanggotaan hanya ada untuk orang yang benar-benar sudah punya akun —
/// email yang diundang belum tentu pernah login lewat Google.
model StoreInvite {
  id         String    @id @default(cuid())
  storeId    String    @map("store_id")
  /// Email Google tujuan, disimpan lowercase.
  email      String
  role       StoreRole @default(STAFF)
  permissions Json?
  /// Kode 8 karakter yang diketik anggota di layar "Gabung Toko".
  code       String    @unique
  invitedBy  String    @map("invited_by")
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  store   Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inviter User  @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([storeId])
  @@map("store_invites")
}

model Backup {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  storeId   String?  @map("store_id")
  fileName  String   @map("file_name")
  fileKey   String   @map("file_key")
  fileSize  Int      @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("backups")
}

model PaymentTransaction {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  planId            String   @map("plan_id")
  amount            Int
  status            String
  paymentGatewayRef String?  @map("payment_gateway_ref")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("payment_transactions")
}

/// Satu baris per permintaan scan yang benar-benar diproses provider.
/// Dipakai untuk menghitung kuota bulanan sekaligus sebagai jejak biaya —
/// percobaan yang gagal total tidak dicatat, supaya foto buram tidak memakan
/// jatah pengguna.
model AiScanUsage {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  storeId      String?  @map("store_id")
  provider     String
  model        String
  /// Jenis masukan yang diproses. Kuotanya tetap satu ember bersama: pemilik
  /// toko tidak perlu tahu bedanya "kuota foto" dan "kuota suara", dia cuma
  /// perlu tahu sisa jatah AI-nya berapa.
  kind         String   @default("image")
  /// Jumlah foto. 0 untuk pemakaian suara — kolom ini dipertahankan apa adanya
  /// supaya baris lama tidak perlu ditafsir ulang.
  imageCount   Int      @map("image_count")
  /// Panjang rekaman dalam milidetik, hanya untuk `kind = "audio"`. Biaya
  /// audio dihitung per detik, jadi tanpa kolom ini jejak biaya suara tidak
  /// bisa direkonsiliasi dengan tagihan provider.
  durationMs   Int?     @map("duration_ms")
  /// Jumlah baris produk yang dikembalikan provider. 0 berarti diproses tapi
  /// tidak ada yang terbaca — tetap dicatat untuk analisis, tapi tidak
  /// dihitung sebagai pemakaian kuota (lihat `countsAgainstQuota`).
  rowCount     Int      @map("row_count")
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  countsAgainstQuota Boolean @default(true) @map("counts_against_quota")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_scan_usages")
}

/// Satu sesi mikrofon Keranjang Suara di kasir. Pengenalan suaranya berjalan
/// di perangkat dan tidak berbiaya, jadi tabel ini murni penjaga jatah
/// pengguna gratis — terpisah dari `AiScanUsage` yang menjaga biaya provider.
///
/// `clientSessionId` dibuat perangkat. Sesi yang terjadi saat offline dikirim
/// belakangan, dan id inilah yang membuat pengiriman ulang tidak tercatat dua kali.
model VoiceCartSession {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  clientSessionId String   @map("client_session_id")
  storeId         String?  @map("store_id")
  /// Kapan mikrofon menyala di perangkat — dasar periode kuota.
  startedAt       DateTime @map("started_at")
  /// true bila dicatat lewat sinkron setelah offline.
  offline         Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientSessionId])
  @@index([userId, startedAt])
  @@map("voice_cart_sessions")
}

model SyncRecord {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  /// Perangkat asal record. Wajib sejak sync dua arah: `localId` adalah
  /// auto-increment Dexie yang berjalan sendiri-sendiri di tiap perangkat,
  /// jadi tanpa kolom ini transaksi id 5 dari tablet kasir menimpa transaksi
  /// id 5 milik HP owner. Kosong = baris warisan sebelum kolom ini ada.
  deviceId  String   @default("") @map("device_id")
  tableName String   @map("table_name")
  localId   String   @map("local_id")
  payload   Json
  syncedAt  DateTime @default(now()) @map("synced_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storeId, tableName, deviceId, localId])
  @@index([syncedAt])
  @@index([userId, syncedAt])
  @@index([storeId, syncedAt])
  @@index([storeId, tableName, syncedAt])
  @@map("sync_records")
}

/// Jejak setiap mutasi yang dilakukan lewat panel admin. Ditulis oleh
/// `modules/admin/audit.ts` — panel bisa mengubah data uang dan membuka data
/// seluruh pelanggan, jadi tidak ada mutasi admin yang boleh tanpa catatan.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  reason     String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Installer aplikasi yang dibagikan di luar Play Store. File-nya disimpan di
/// storage (MinIO/S3); baris ini yang menentukan versi mana yang diunduh
/// halaman /download dan dicek aplikasi saat dibuka.
model AppRelease {
  id           String          @id @default(cuid())
  platform     ReleasePlatform
  versionName  String          @map("version_name")
  /// Pembanding versi. Harus naik terus per platform — aplikasi menganggap
  /// ada update bila angka ini lebih besar dari miliknya.
  versionCode  Int             @map("version_code")
  fileKey      String          @map("file_key")
  fileName     String          @map("file_name")
  fileSize     Int             @map("file_size")
  sha256       String
  changelog    String          @default("")
  /// Aplikasi di bawah versi ini tidak boleh lanjut dipakai sebelum update.
  mandatory    Boolean         @default(false)
  /// Kosong = draf, belum terlihat oleh pengguna.
  publishedAt  DateTime?       @map("published_at")
  downloads    Int             @default(0)
  uploadedById String          @map("uploaded_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@unique([platform, versionCode])
  @@index([platform, publishedAt])
  @@map("app_releases")
}
