# Server
PORT=3210
NODE_ENV=development

# Database
DATABASE_URL=postgresql://kanpos:kanpos123@localhost:5432/kanpos_pos

# Google OAuth (untuk verifikasi ID token)
# Boleh beberapa client ID dipisah koma (kasir, dashboard, admin)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Storage (S3-compatible, contoh MinIO)
STORAGE_TYPE=s3
STORAGE_ENDPOINT=storage.codecircle.cloud
STORAGE_PORT=19000
STORAGE_USE_SSL=true
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=mzyPzCy5fse8xLp6
STORAGE_REGION=us-east-1
STORAGE_BUCKET=kanpos

# Payment Gateway — Tripay
TRIPAY_MODE=sandbox
TRIPAY_MERCHANT_CODE=your-merchant-code
TRIPAY_API_KEY=your-api-key
TRIPAY_PRIVATE_KEY=your-private-key

# URL callback/return Tripay
TRIPAY_CALLBACK_URL=https://api.kanpos-anda.com/api/payments/callback
TRIPAY_RETURN_URL=https://kanpos-anda.com/payment/return

# JWT untuk internal signing (opsional)
JWT_SECRET=change-this-secret

# ── Panel admin ───────────────────────────────────────────────
# Email yang diangkat jadi SUPERADMIN saat login pertama (pisahkan dengan koma)
ADMIN_EMAILS=banidevv@gmail.com
# Origin yang boleh memanggil /api/admin/* (pisahkan dengan koma)
ADMIN_ORIGIN=http://localhost:5176
# Umur sesi admin dalam jam
ADMIN_SESSION_HOURS=8

# Scan produk dari foto (vision)
# disabled = fitur mati; gemini = pakai Google Gemini (punya free tier)
VISION_PROVIDER=disabled
GEMINI_API_KEY=
# Nama model bisa diganti tanpa deploy ulang. Cek model yang tersedia di
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
# Batas tunggu panggilan ke provider (detik)
VISION_TIMEOUT_SECONDS=120
# Batas foto sekali proses
VISION_MAX_IMAGES=5
# Jatah scan bulanan untuk pengguna tanpa langganan aktif
VISION_FREE_QUOTA=5

# Batas panjang rekaman suara (detik) untuk input produk lewat suara.
# 60 detik cukup untuk sekitar delapan produk; lebih dari itu pemilik toko
# lupa apa saja yang sudah disebut dan hasilnya justru sulit ditinjau.
SPEECH_MAX_SECONDS=60

# Jatah sesi Keranjang Suara (kasir) per bulan untuk pengguna tanpa langganan.
# Pelanggan berbayar tidak dibatasi.
VOICE_CART_FREE_QUOTA=10

# Alamat publik API, dipakai menyusun link unduhan installer aplikasi
# (/api/releases/download/...). Kosong = diturunkan dari header permintaan.
PUBLIC_API_URL=https://api-kanpos.codecircle.cloud
# Batas ukuran file installer (APK/EXE) yang boleh diunggah dari panel admin, MB.
# Samakan dengan client_max_body_size di Nginx.
RELEASE_MAX_MB=400
